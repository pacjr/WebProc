# Actus Connect — frontend build-time configuration (copy to .env for local dev; never commit .env)
#
# Required for npm run dev / npm run build:
#   VITE_SUPABASE_URL — Supabase project API URL (HTTPS), e.g. https://YOUR_PROJECT_REF.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY — browser-safe anon/publishable key from Supabase Dashboard → API
#
# Do NOT put service_role, R2, Edge, or SMTP secrets in Vite env (they are not frontend-safe).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional metadata (CLI/docs); not required by src/integrations/supabase/client.ts
VITE_SUPABASE_PROJECT_ID=

# Public base URL of the institutional Actus Site (optional; dev default in site-entry.ts)
VITE_SITE_PUBLIC_URL=http://localhost:5173
